{
  "name": "@muajigyeong/ui",
  "version": "0.4.1",
  "description": "Muajigyeong shared React UI components",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "import": "./dist/accordion/index.js"
    },
    "./check-chip": {
      "types": "./dist/check-chip/index.d.ts",
      "import": "./dist/check-chip/index.js"
    },
    "./choice-select": {
      "types": "./dist/choice-select/index.d.ts",
      "import": "./dist/choice-select/index.js"
    },
    "./controlled-input": {
      "types": "./dist/controlled-input/index.d.ts",
      "import": "./dist/controlled-input/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./section-with-header": {
      "types": "./dist/section-with-header/index.d.ts",
      "import": "./dist/section-with-header/index.js"
    },
    "./form-action-buttons": {
      "types": "./dist/form-action-buttons/index.d.ts",
      "import": "./dist/form-action-buttons/index.js"
    },
    "./status-toast": {
      "types": "./dist/status-toast/index.d.ts",
      "import": "./dist/status-toast/index.js"
    },
    "./text-field": {
      "types": "./dist/text-field/index.d.ts",
      "import": "./dist/text-field/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./modal-dialogs": {
      "types": "./dist/modal-dialogs/index.d.ts",
      "import": "./dist/modal-dialogs/index.js"
    },
    "./popup-choice": {
      "types": "./dist/popup-choice/index.d.ts",
      "import": "./dist/popup-choice/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.docs.json",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build:docs": "storybook build --disable-telemetry",
    "prepare": "npm run build",
    "pack": "npm pack",
    "test:browser": "npm run build:docs && node scripts/verify-components.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "vite": "^7.0.0",
    "playwright": "1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@mua/team-muajigyeong/muajigyeong-ui.git"
  }
}
